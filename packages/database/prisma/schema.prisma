generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserType {
  STUDENT
  FACULTY
  INDIVIDUAL
}

model User {
  id              String       @id @default(uuid())
  username        String       @unique
  email           String       @unique
  googleSub       String?      @unique
  passwordHash    String?
  userType        UserType     @default(INDIVIDUAL)
  primaryEmail    String?
  secondaryEmail  String?
  institutionName String?
  department      String?
  batchYear       String?
  platformCode    String?      @unique // e.g. "AF-STU-74921" or "AF-FAC-10293"
  rating          Int          @default(0) // Base ELO rating (starts at 0)
  arenaPoints     Int          @default(0) // Independent redeemable reward balance
  ewma            Float        @default(0.50) // Exponentially Weighted Moving Average of recent performance
  highestRating   Int          @default(0)
  highestRank     String       @default("ROOKIE")
  wins            Int          @default(0)
  losses          Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  submissions     Submission[]
  participants    BattleParticipant[]
  hostedRooms     BattleRoom[] @relation("HostedRooms")
  teamCaptains    BattleTeam[] @relation("TeamCaptains")
  ratingHistories RatingHistory[]
  quizzes         Quiz[]
  arenaPointTransactions ArenaPointTransaction[]
  achievements           UserAchievement[]
  weeklyActivities       WeeklyActivity[]
  githubUrl       String?
  linkedinUrl     String?

  // Institutional Student Identity (Stable Fields)
  institutionId           String?
  institutionDomain       String?
  admissionYear           Int?
  branch                  String?
  enrollmentNumber        String?
  studentIdentityMetadata Json?

  // Track high-level counts
  totalSubmissions Int @default(0)
  totalExecutions  Int @default(0)

  @@index([institutionDomain])
  @@index([institutionId])
}

enum Verdict {
  ACCEPTED
  WRONG_ANSWER
  TIME_LIMIT_EXCEEDED
  MEMORY_LIMIT_EXCEEDED
  OUTPUT_LIMIT_EXCEEDED
  COMPILATION_ERROR
  RUNTIME_ERROR
  INTERNAL_ERROR
  SYSTEM_ERROR     
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum SubmissionStatus {
  CREATED
  QUEUED
  COMPILING
  RUNNING
  EVALUATING
  FINALIZED
}

model TestCase {
  id             String  @id @default(uuid())
  problemId      String
  problem        Problem @relation(fields: [problemId], references: [id])
  input          String
  expectedOutput String

  isHidden  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([problemId])
}

model Problem {
  id          String       @id @default(uuid())
  title       String
  statement   String
  difficulty  Difficulty
  category    String?      // e.g. "Arrays & Hashing", "Two Pointers", "Dynamic Programming"
  tags        String[]     @default([])
  timeLimit   Int          // in milliseconds
  memoryLimit Int          // in MB
  // --- Provenance for imported problems (e.g. HuggingFace datasets) ---
  source      String?      // e.g. "code_contests"
  externalId  String?      @unique // stable id from the source, used for idempotent re-imports
  sourceUrl   String?      // canonical link back to the original problem, when available
  creatorId   String?
  creatorRole String?
  // -------------------------------------------------------------------
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  testCases   TestCase[]
  submissions Submission[]
  battleRooms BattleRoom[]

  @@index([source])
}

model Submission {
  id String @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  problemId String
  problem   Problem  @relation(fields: [problemId], references: [id])
  roomId    String?
  room      BattleRoom?  @relation(fields: [roomId], references: [id])
  language  String
  code      String
  status    SubmissionStatus @default(CREATED)
  
  // --- AGGREGATE METRIC FIELDS ---
  // We keep these here for quick caching, but the granular 
  // history is handled by your external Linux server!
  verdict       Verdict?
  cpuUsage      Float?     // Peak or average CPU
  memoryUsage   Float?     // Peak memory across all test cases
  compileTime   Int?       // Total compilation time
  // -----------------------------------

  stdout        String?
  stderr        String?
  executionTime Int?
  exitCode      Int?
  retryCount    Int @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([roomId])
  @@index([createdAt])
  @@index([problemId])
}

enum BattleMode {
  DUEL_1V1
  SQUAD_BATTLE
  PRACTICE_SOLO
}

enum SquadTeamSide {
  ALPHA
  BETA
}

enum BattleRoomStatus {
  WAITING     // In lobby, waiting for players
  READY       // All players ready, countdown started
  RUNNING     // Battle in progress
  FINISHED    // Battle concluded
  CANCELLED   // Room closed/abandoned
}

model BattleRoom {
  id               String           @id @default(uuid())
  roomCode         String           @unique
  hostId           String
  host             User             @relation("HostedRooms", fields: [hostId], references: [id])
  battleMode       BattleMode       @default(DUEL_1V1)
  squadSize        Int?             @default(2) // 2 for 2v2, 3 for 3v3
  rosterVersion    Int              @default(1) // Incremented on roster modifications
  maxPlayers       Int              @default(2)
  status           BattleRoomStatus @default(WAITING)
  
  // ▼ REPLACE problemId and problem WITH THESE 3 LINES ▼
  problems         Problem[]
  difficulty       String           @default("Mix")
  questionCount    Int              @default(3)
  // ▲ ----------------------------------------------- ▲
  isFriendly       Boolean          @default(false)
  roomType         String           @default("RATED") // "RATED" or "UNRATED"
  
  timeLimitMinutes Int              @default(15)
  startedAt        DateTime?
  endedAt          DateTime?
  createdAt        DateTime         @default(now())
  participants     BattleParticipant[]
  teams            BattleTeam[]
  teamScores       TeamProblemScore[]
  submissions      Submission[] 
  ratingHistories  RatingHistory[]
  
  @@index([hostId])
  @@index([status])
  @@index([roomCode])
}

model BattleTeam {
  id                 String              @id @default(uuid())
  battleRoomId       String
  teamSide           SquadTeamSide
  captainUserId      String
  invitationCodeHash String              // SHA-256 hash of team invitation code
  score              Int                 @default(0)
  isApproved         Boolean             @default(false)
  approvedVersion    Int                 @default(0)
  approvedAt         DateTime?

  battleRoom         BattleRoom          @relation(fields: [battleRoomId], references: [id], onDelete: Cascade)
  captain            User                @relation("TeamCaptains", fields: [captainUserId], references: [id])
  participants       BattleParticipant[]
  problemScores      TeamProblemScore[]

  @@unique([battleRoomId, teamSide])
  @@index([battleRoomId])
  @@index([captainUserId])
}

model BattleParticipant {
  roomId           String
  userId           String
  teamId           String?
  participantCode  String?             // "A-01", "A-02", "B-01", "B-02", etc.
  joinedAt         DateTime            @default(now())
  isReady          Boolean             @default(false)
  score            Int                 @default(0)
  rank             Int?     
  solvedAt         DateTime?  
  
  // ▼ ADD THIS LINE ▼
  solvedProblemIds String[]            @default([])
  
  room             BattleRoom          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  team             BattleTeam?         @relation(fields: [teamId], references: [id], onDelete: SetNull)
  
  @@id([roomId, userId])
  @@index([userId])
  @@index([teamId])
}

model TeamProblemScore {
  id             String      @id @default(uuid())
  battleRoomId   String
  teamId         String
  problemId      String
  solvedByUserId String
  submissionId   String?
  points         Int         @default(100)
  timeSeconds    Int         @default(0)
  awardedAt      DateTime    @default(now())

  battleRoom     BattleRoom  @relation(fields: [battleRoomId], references: [id], onDelete: Cascade)
  team           BattleTeam  @relation(fields: [teamId], references: [id], onDelete: Cascade)

  // Enforces at the database engine level that a team only scores ONCE per problem
  @@unique([battleRoomId, teamId, problemId])
  @@index([battleRoomId])
  @@index([teamId])
}

model RatingHistory {
  id               String      @id @default(uuid())
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  battleRoomId     String?
  battleRoom       BattleRoom? @relation(fields: [battleRoomId], references: [id], onDelete: SetNull)
  ratingBefore     Int
  ratingAfter      Int
  ratingDelta      Int
  performanceScore Float
  ewmaBefore       Float
  ewmaAfter        Float
  metadata         Json?
  createdAt        DateTime    @default(now())

  @@index([userId])
  @@index([battleRoomId])
  @@index([createdAt])
}

model SystemBroadcast {
  id          String    @id @default(uuid())
  title       String
  message     String
  type        String    @default("INFO") // INFO, WARNING, UPDATE, FEEDBACK, MAINTENANCE, EVENT
  flashBanner Boolean   @default(true)
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  createdBy   String    @default("SuperAdmin")
  revokedAt   DateTime?

  // Optional JSON metadata for content (media) & action (links)
  content     Json?
  action      Json?

  @@index([expiresAt])
  @@index([revokedAt])
  @@index([createdAt])
}

model Quiz {
  id              String      @id @default(uuid())
  title           String
  description     String?
  creatorId       String
  creator         User        @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  institutionName String?
  department      String?     // Eligibility department / branch (e.g. "Computer Science & Engineering", "All")
  batchYear       String?     // Eligibility batch (e.g. "2026", "All")
  durationMinutes Int         @default(30)
  startTime       DateTime?
  endTime         DateTime?
  status          String      @default("SCHEDULED") // DRAFT, SCHEDULED, ACTIVE, COMPLETED
  problemIds      String[]    @default([])
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([creatorId])
  @@index([department])
  @@index([status])
}

model ArenaPointTransaction {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int      // Positive for earnings, negative for redemptions
  type      String   // PROBLEM_SOLVED, RATED_BATTLE, CONSISTENCY_REWARD, MILESTONE_REWARD, REWARD_REDEMPTION, ADMIN_ADJUSTMENT
  source    String?  // Context identifier, e.g. "PROBLEM", "BATTLE", "WEEKLY", "ACHIEVEMENT"
  sourceId  String?  // Id of the underlying problem, room, week, etc.
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model UserAchievement {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementKey String
  title          String
  rewardAmount   Int
  unlockedAt     DateTime @default(now())
  metadata       Json?

  @@unique([userId, achievementKey])
  @@index([userId])
}

model WeeklyActivity {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekKey           String   // e.g. "2026-W40"
  activeDays        Int[]    @default([]) // Array of day indices 0-6 (Sun-Sat)
  claimedMilestones Int[]    @default([]) // Thresholds claimed, e.g. [3, 5, 7]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([userId, weekKey])
  @@index([userId])
}

enum IntelCategory {
  ANNOUNCEMENT
  PRODUCT_UPDATE
  EVENT
  COMMUNITY
  ENGINEERING
}

enum IntelPostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum IntelEventType {
  TOURNAMENT
  WORKSHOP
  FEATURE_LAUNCH
  SEASON_RESET
  COMMUNITY
}

enum LaunchStatus {
  UPCOMING
  ROLLING_OUT
  LIVE
  POSTPONED
  CANCELLED
}

model IntelPost {
  id             String          @id @default(uuid())
  slug           String          @unique
  title          String
  summary        String
  content        String
  category       IntelCategory
  coverImageUrl  String?
  authorName     String          @default("AlgoFight Team")
  authorAvatar   String?
  status         IntelPostStatus @default(DRAFT)
  isFeatured     Boolean         @default(false)
  views          Int             @default(0)
  readingTimeMin Int             @default(3)
  publishedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  eventDetails   IntelEvent?

  @@index([status, publishedAt])
  @@index([category])
  @@index([isFeatured])
  @@index([slug])
}

model IntelEvent {
  id                   String         @id @default(uuid())
  postId               String         @unique
  post                 IntelPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  eventType            IntelEventType @default(FEATURE_LAUNCH)
  versionTag           String?
  startsAt             DateTime
  endsAt               DateTime?
  timezone             String         @default("UTC")
  registrationOpensAt  DateTime?
  registrationClosesAt DateTime?
  actionUrl            String?
  actionLabel          String?
  location             String?
  isOnline             Boolean        @default(true)
  launchStatus         LaunchStatus   @default(UPCOMING)

  @@index([eventType])
  @@index([startsAt])
  @@index([launchStatus])
}



