generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum SubmissionStatus {
  CREATED
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  RETRYING
  STALE
}

model Problem {
  id String @id @default(uuid())

  title     String
  statement String

  difficulty Difficulty

  timeLimit   Int
  memoryLimit Int

  submissions Submission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Submission {
  id String @id @default(uuid())

  userId    String?
  problemId String

  problem Problem @relation(fields: [problemId], references: [id])

  language String
  code     String

  status SubmissionStatus @default(CREATED)

  stdout String?
  stderr String?

  executionTime Int?
  exitCode      Int?

  retryCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([problemId])
}
